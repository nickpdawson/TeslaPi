[Unit]
Description=TeslaPi Web Dashboard
After=network-online.target
Wants=network-online.target
# The DB lives at /mutable/teslapi/teslapi.db — don't start until /mutable is mounted,
# otherwise the DB is written to the rootfs mountpoint and shadowed when it mounts.
RequiresMountsFor=/mutable

[Service]
Type=exec
User=root
Group=root
WorkingDirectory=/opt/teslapi
# Bind to loopback only — nginx (same host) proxies to 127.0.0.1:8080 and is the sole
# public listener (SOL-001). Binding 0.0.0.0 exposed the API directly on :8080,
# bypassing nginx and any front-door controls.
ExecStart=/opt/teslapi/venv/bin/uvicorn backend.main:app --host 127.0.0.1 --port 8080 --workers 1 --log-level warning
Restart=always
RestartSec=5
Environment=TESLAPI_DATABASE_PATH=/mutable/teslapi/teslapi.db
Environment=TESLAPI_DEV_MODE=false

# Resource limits for Pi 4
MemoryMax=256M
CPUQuota=50%

# Security hardening (relaxed — strict mode fails when teslausb paths don't exist yet)
ProtectHome=true
NoNewPrivileges=false

[Install]
WantedBy=multi-user.target
